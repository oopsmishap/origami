{
  "name": "origami",
  "version": "0.5.2",
  "description": "First-principles incremental hierarchical context folding for oh-my-pi",
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/oopsmishap/origami.git"
  },
  "omp": {
    "extensions": ["./src/index.ts"]
  },
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "test": "bun test",
    "typecheck": "tsc --noEmit",
    "bench": "bun bench/marathon.ts",
    "replay": "bun bench/replay.ts",
    "replay:smoke": "bun bench/replay.ts --session tests/fixtures/replay-session.jsonl --mode simulated --policy both",
    "replay:matrix": "bun bench/replay.ts --session tests/fixtures/replay-session.jsonl --preset all --policy both",
    "bench:billion": "bun bench/billion.ts",
    "bench:real-world": "bun bench/real-world.ts",
    "bench:agentic": "bun bench/agentic/runner.ts",
    "bench:agentic:smoke": "bun bench/agentic/runner.ts --mode programming --scale low --strategy all --mock",
    "bench:agentic:web": "bun bench/agentic/runner.ts --web"
  },
  "peerDependencies": {
    "@oh-my-pi/pi-coding-agent": ">=18.6.0",
    "@oh-my-pi/pi-natives": ">=18.6.0",
    "@oh-my-pi/pi-tui": ">=18.6.0"
  },
  "peerDependenciesMeta": {
    "@oh-my-pi/pi-coding-agent": {
      "optional": true
    },
    "@oh-my-pi/pi-natives": {
      "optional": true
    },
    "@oh-my-pi/pi-tui": {
      "optional": true
    }
  },
  "devDependencies": {
    "@oh-my-pi/pi-coding-agent": "^18.13.2",
    "@oh-my-pi/pi-natives": "^18.13.2",
    "@oh-my-pi/pi-tui": "^18.13.2",
    "@oh-my-pi/pi-wire": "^18.13.2",
    "@types/bun": "^1.2.0",
    "typescript": "^5.6.0"
  }
}